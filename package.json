{
  "name": "@pzv-terminal/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "nx": "nx",
    "dev": "nx run-many -t serve -p server worker --output-style=stream",
    "dev:server": "nx serve server --output-style=stream",
    "dev:worker": "nx serve worker --output-style=stream",
    "kill": "pkill -f 'nx serve' || true",
    "kill:ports": "lsof -ti:3000 -ti:3001 | xargs kill -9",
    "kill:node": "pkill -u $USER node || true",
    "build:server": "nx build server",
    "build:worker": "nx build worker",
    "build": "nx run-many -t build -p server worker",
    "lint": "nx run-many -t lint --all",
    "test": "nx run-many -t test --all",
    "e2e:server": "nx run server-e2e:e2e",
    "e2e:worker": "nx run worker-e2e:e2e",
    "reset": "nx reset",
    "graph": "nx graph",
    "projects": "nx show projects"
  },
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "nx",
      "@swc/core",
      "@nestjs/core",
      "@parcel/watcher",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "22.5.0",
    "@nx/eslint-plugin": "22.5.0",
    "@nx/jest": "22.5.0",
    "@nx/js": "22.5.0",
    "@nx/nest": "22.5.0",
    "@nx/node": "^22.5.0",
    "@nx/web": "22.5.0",
    "@nx/webpack": "22.5.0",
    "@nx/workspace": "22.5.0",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^30.0.2",
    "jest-environment-node": "^30.0.2",
    "jest-util": "^30.0.2",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "22.5.0",
    "pino-pretty": "^13.1.3",
    "prettier": "~3.6.2",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "axios": "^1.6.0",
    "dotenv": "^17.3.1",
    "pino": "^10.3.1",
    "redis": "^5.11.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "zod": "^4.3.6"
  }
}
